# Pack4U environment variables — copy to `.env.local` and fill in.
# All are OPTIONAL: the site runs without them (features degrade gracefully).

# ── Lead email notifications (Resend) ────────────────────────────────
# Used by src/app/api/lead/route.ts to email new quote/contact leads.
# Leave blank if you route lead mail through your own server (e.g. Cloudflare
# Email Routing / a custom webhook) instead of Resend.
RESEND_API_KEY=
# Inbox that receives new-lead notifications (e.g. leads@pack4u.store).
LEADS_NOTIFY_EMAIL=

# ── Analytics (client-side, public) ──────────────────────────────────
# Read in src/components/analytics.tsx. Tracking is disabled when unset.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
